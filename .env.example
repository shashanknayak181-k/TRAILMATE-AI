# Application
APP_NAME=TRAILMATE AI
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5173

# Database: PostgreSQL recommended for deployment; SQLite allowed for local development
DATABASE_URL=sqlite:///./trailmate_dev.db
# Example production shape (replace with secret-managed credentials):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/trailmate

# Authentication (generate a unique random value for each environment)
SECRET_KEY=replace-with-a-long-random-secret-before-use
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Email integration - not active until provider adapter is implemented/configured
EMAIL_PROVIDER=development
EMAIL_FROM=noreply@example.invalid
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Map/search services currently use documented public endpoints for this MVP.
# These optional values are reserved for future provider adapters; do not put secrets in frontend code.
MAP_PROVIDER=
MAP_API_KEY=

# Optional LLM adapter - not active until configured
LLM_PROVIDER=
LLM_API_KEY=
